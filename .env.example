# Copy to .env.local and fill in. Never commit .env.local.

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API > anon public key (safe in the browser, protected by row-level security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > service_role key
# SERVER ONLY. Bypasses row-level security. Used for "Delete account and all data". Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Where the app runs. Used for magic-link and Google sign-in redirects.
# Local: http://localhost:3000   Production: your Vercel domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct Postgres connection string (Supabase > Project Settings > Database). Migrations only, never exposed to the browser.
DATABASE_URL=

# Optional. Groq API key for the AI screenshot check. Server only, never NEXT_PUBLIC_.
GROQ_API_KEY=
# Optional. Overrides the default vision model.
GROQ_VISION_MODEL=
